<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/light_pink">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bill Details"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="16dp"
        android:textColor="@color/deep_plum"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Month:"
        android:textStyle="bold"
        android:textColor="@color/deep_plum"/>

    <TextView
        android:id="@+id/textViewMonth"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:padding="8dp"
        android:text="January"
        android:textColor="@color/deep_plum" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Electricity Usage:"
        android:textStyle="bold"
        android:textColor="@color/deep_plum"/>

    <TextView
        android:id="@+id/textViewUnits"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:padding="8dp"
        android:text="150 kWh"
        android:textColor="@color/deep_plum" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Total Charges:"
        android:textStyle="bold"
        android:textColor="@color/deep_plum"/>

    <TextView
        android:id="@+id/textViewTotalCharges"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:padding="8dp"
        android:text="RM 32.70"
        android:textColor="@color/deep_plum" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rebate:"
        android:textStyle="bold"
        android:textColor="@color/deep_plum"/>

    <TextView
        android:id="@+id/textViewRebate"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:padding="8dp"
        android:text="0%"
        android:textColor="@color/deep_plum" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Final Cost:"
        android:textStyle="bold"
        android:textColor="@color/deep_plum"/>

    <TextView
        android:id="@+id/textViewFinalCost"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:padding="8dp"
        android:text="RM 32.70"
        android:textColor="@color/deep_plum"
        android:textSize="20sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/buttonEdit"
        android:layout_width="280dp"
        android:layout_gravity="center"
        android:layout_height="wrap_content"
        android:text="✏️  EDIT RECORD"
        android:backgroundTint="#D98BAA"
        android:textColor="@color/white"/>

    <Button
        android:id="@+id/buttonBack"
        android:layout_width="280dp"
        android:layout_gravity="center"
        android:layout_height="wrap_content"
        android:text="BACK"
        android:backgroundTint="@color/pink"
        android:textColor="@color/white"/>

    <Button
        android:id="@+id/buttonDelete"
        android:layout_width="280dp"
        android:layout_gravity="center"
        android:layout_height="wrap_content"
        android:text="🗑️  DELETE RECORD"
        android:backgroundTint="@color/purple"
        android:textColor="@color/white"/>
</LinearLayout>