<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/light_pink">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Edit Bill Record"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="16dp"
        android:textColor="@color/deep_plum"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Month:"
        android:textColor="@color/deep_plum"/>

    <EditText
        android:id="@+id/editTextMonth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter month"
        android:inputType="textCapWords"
        android:textColor="@color/deep_plum"
        android:textColorHint="@color/purple"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Electricity Usage (kWh):"
        android:textColor="@color/deep_plum"/>

    <EditText
        android:id="@+id/editTextUnits"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter units (1 - 1000)"
        android:inputType="number"
        android:maxLength="4"
        android:textColor="@color/deep_plum"
        android:textColorHint="@color/purple"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rebate (%):"
        android:textColor="@color/deep_plum"/>

    <EditText
        android:id="@+id/editTextRebate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter rebate (0 - 5)"
        android:inputType="number"
        android:maxLength="1"
        android:textColor="@color/deep_plum"
        android:textColorHint="@color/purple"/>

    <Button
        android:id="@+id/buttonUpdate"
        android:layout_width="280dp"
        android:layout_gravity="center"
        android:layout_height="wrap_content"
        android:text="UPDATE RECORD"
        android:backgroundTint="@color/purple"
        android:textColor="@color/white"/>

    <Button
        android:id="@+id/buttonBack"
        android:layout_width="280dp"
        android:layout_gravity="center"
        android:layout_height="wrap_content"
        android:text="BACK"
        android:backgroundTint="@color/pink"
        android:textColor="@color/white"/>

</LinearLayout>